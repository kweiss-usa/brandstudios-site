# Brand Studios
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Send all http traffic to https (certificate renewals stay on http)
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://brandstudios.com/$1 [R=301,L]
# Send www to the main address
RewriteCond %{HTTP_HOST} ^www\.brandstudios\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://brandstudios.com/$1 [R=301,L]
# Serve WebP copies of images to browsers that accept them
RewriteCond %{HTTP:Accept} image/webp
RewriteCond %{REQUEST_FILENAME} ^(.+)\.(png|jpe?g)$ [NC]
RewriteCond %1.webp -f
RewriteRule ^(.+)\.(png|jpe?g)$ $1.webp [T=image/webp,L]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(png|jpe?g)$">
Header append Vary Accept
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType text/css "access plus 1 week"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
